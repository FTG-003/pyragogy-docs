---
import { ViewTransitions } from 'astro:transitions';
import CitationCard from '../components/CitationCard.astro';
import CitationStats from '../components/CitationStats.astro';

// Static citation data
const citations = [
  {
    title: "Peer Learning in Education 4.0",
    quote: "This vector of educational evolution continues in the direction of pyragogy, which emphasizes community-based learning, mutual support, lifelong self-learning and learning in knowledge management networks.",
    authors: ["Aigerim Mynbayeva", "Kamchat Yessenova", "Anzhelika Karabutova"],
    source: "Scientific Herald of Uzhhorod University. Series -Physics-",
    doi: "10.54919/physics/55.2024.291vr9",
    url: "https://physics.uz.ua/en/journals/issue-55-2024/exploring-heutagogy-knowledge-management-and-rhizomatic-learning-approaches-in-master-s-degree-programs",
    tags: ["peer learning", "education 4.0", "digital technologies", "collaborative learning"],
    year: 2024,
    publicationType: "journal",
    verified: true
  },
];

const pageTitle = "Citations & Academic References | Pyragogy";
const pageDescription = "Comprehensive collection of academic references, research papers, and citations supporting Pyragogy methodology. Explore peer learning, AI-enhanced education, and collaborative knowledge construction.";
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://pyragogy.org');
const verifiedCount = citations.filter(c => c.verified).length;
const totalCitations = citations.length;

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": pageUrl.href,
  "publisher": {
    "@type": "Organization",
    "name": "Pyragogy",
    "url": "https://pyragogy.org"
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": totalCitations,
    "itemListElement": citations.map((citation, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "ScholarlyArticle",
        "name": citation.title,
        "author": citation.authors.map(author => ({
          "@type": "Person",
          "name": author
        })),
        "datePublished": citation.year?.toString(),
        "publisher": {
          "@type": "Organization",
          "name": citation.source
        },
        "identifier": citation.doi ? `https://doi.org/${citation.doi}` : citation.url,
        "keywords": citation.tags.join(", ")
      }
    }))
  }
};
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Primary Meta Tags -->
  <title>{pageTitle}</title>
  <meta name="title" content={pageTitle} />
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="pyragogy, citations, academic references, peer learning, AI education, collaborative learning, research papers" />
  <meta name="author" content="Pyragogy Team" />
  <meta name="robots" content="index, follow" />
  
  <!-- Canonical URL -->
  <link rel="canonical" href={pageUrl.href} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl.href} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={`${Astro.site}images/peeragogy_bot.webp`} />
  <meta property="og:image:alt" content="Pyragogy Academic Citations Collection" />
  <meta property="og:site_name" content="Pyragogy" />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={pageUrl.href} />
  <meta property="twitter:title" content={pageTitle} />
  <meta property="twitter:description" content={pageDescription} />
  <meta property="twitter:image" content={`${Astro.site}images/peeragogy_bot.webp`} />
  
  <!-- Additional SEO -->
  <meta name="theme-color" content="#5D2DFD" />
  <meta name="msapplication-TileColor" content="#5D2DFD" />
  
  <!-- Preload critical resources -->
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="dns-prefetch" href="https://doi.org" />
  <link rel="dns-prefetch" href="https://plausible.pyragogy.org" />
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
  <ViewTransitions />
</head>
<body>
  <main class="citations-page">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Citations</li>
          </ol>
        </nav>
        
        <h1 class="hero-title">Citations & References</h1>
        <p class="hero-description">
          Academic foundations and research supporting the Pyragogy methodology
        </p>
        
        <div class="hero-stats">
          <span class="stat-item">
            <strong>{totalCitations}</strong> citations
          </span>
          <span class="stat-item">
            <strong>{verifiedCount}</strong> verified
          </span>
          <span class="stat-item">
            <strong>{new Set(citations.map(c => c.year)).size}</strong> years
          </span>
        </div>
      </div>
    </section>

    <!-- How to Cite Section -->
    <section class="cite-section">
      <div class="cite-container">
        <button class="cite-toggle" id="cite-toggle" aria-expanded="false" aria-controls="cite-content">
          <h2 class="cite-title">📚 How to Cite the Pyragogy Project</h2>
          <svg class="toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        
        <div class="cite-content" id="cite-content" aria-hidden="true">
          <p class="cite-description">
            If you wish to cite the <strong>Pyragogy</strong> project in your academic, research, creative, or technical work, please use the formats below. These citations ensure proper attribution and help spread the vision of co-created, human–AI symbiotic learning.
          </p>

          <div class="citation-formats">
            <div class="format-group">
              <h3>🔹 General Project Citation</h3>
              
              <div class="format-item">
                <h4>APA</h4>
                <div class="code-container">
                  <code class="citation-code" id="apa-citation">
                    Terzi, F. (2025). <em>Pyragogy: A Symbiotic Framework for Human–AI Co-Learning</em>. Retrieved from https://pyragogy.org
                  </code>
                  <button class="copy-btn" onclick="copyCitation('apa-citation')" aria-label="Copy APA citation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="format-item">
                <h4>MLA</h4>
                <div class="code-container">
                  <code class="citation-code" id="mla-citation">
                    Terzi, Fabrizio. <em>Pyragogy: A Symbiotic Framework for Human–AI Co-Learning</em>. 2025. https://pyragogy.org
                  </code>
                  <button class="copy-btn" onclick="copyCitation('mla-citation')" aria-label="Copy MLA citation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="format-item">
                <h4>Chicago</h4>
                <div class="code-container">
                  <code class="citation-code" id="chicago-citation">
                    Terzi, Fabrizio. 2025. <em>Pyragogy: A Symbiotic Framework for Human–AI Co-Learning</em>. https://pyragogy.org
                  </code>
                  <button class="copy-btn" onclick="copyCitation('chicago-citation')" aria-label="Copy Chicago citation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="format-item">
                <h4>BibTeX</h4>
                <div class="code-container">
                  <code class="citation-code" id="bibtex-citation">
                    {`@misc{terzi2025pyragogy,
  author       = {Terzi, Fabrizio},
  title        = {Pyragogy: A Symbiotic Framework for Human–AI Co-Learning},
  year         = {2025},
  url          = {https://pyragogy.org}
}`}
                  </code>
                  <button class="copy-btn" onclick="copyCitation('bibtex-citation')" aria-label="Copy BibTeX citation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <div class="cite-footer">
              <p>Feel free to reuse this citation section in papers, presentations, websites, or research documentation.</p>
              <p>For updates, visit <a href="https://pyragogy.org" target="_blank" rel="noopener noreferrer">pyragogy.org</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Statistics Section -->
    <CitationStats 
      totalCitations={totalCitations}
      verifiedCount={verifiedCount}
      yearsCovered={new Set(citations.map(c => c.year)).size}
      topicsCount={new Set(citations.flatMap(c => c.tags)).size}
    />

    <!-- Filters Section -->
    <section class="filters-section">
      <div class="filters-container" role="group" aria-labelledby="filter-heading">
        <h3 id="filter-heading" class="visually-hidden">Filter citations</h3>
        
        <div class="search-container">
          <input 
            type="search" 
            id="citation-search" 
            placeholder="Search citations by title, author, or topic..."
            aria-label="Search citations"
            class="search-input"
          />
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>
        
        <div class="filter-buttons">
          <span class="filter-label">Filter by:</span>
          <button class="filter-btn active" data-filter="all" aria-pressed="true">All</button>
          <button class="filter-btn" data-filter="journal" aria-pressed="false">Journal</button>
          <button class="filter-btn" data-filter="conference" aria-pressed="false">Conference</button>
        </div>
      </div>
    </section>

    <!-- Citations Grid -->
    <section class="citations-section" aria-labelledby="citations-heading">
      <div class="citations-container">
        <h2 id="citations-heading" class="visually-hidden">Academic Citations</h2>
        <div class="citations-grid" id="citations-grid" role="list" aria-label="Academic citations list">
          {citations.map((citation, index) => (
            <div role="listitem" class="citation-item">
              <CitationCard 
                title={citation.title}
                quote={citation.quote}
                authors={citation.authors}
                source={citation.source}
                doi={citation.doi}
                url={citation.url}
                tags={citation.tags}
                year={citation.year}
                publicationType={citation.publicationType}
                verified={citation.verified}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</body>
</html>

<style>
  /* Accessibility utilities */
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* Focus styles for accessibility */
  .filter-btn:focus-visible,
  .citation-card:focus-visible {
    outline: 2px solid #5D2DFD;
    outline-offset: 2px;
  }

  .citations-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    color: #f1f5f9;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    /* Improve text rendering */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 1rem;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(30, 41, 59, 0.7), rgba(56, 189, 248, 0.08));
  }

  .hero-content {
    position: relative;
    max-width: 80rem;
    margin: 0 auto;
    text-align: center;
  }

  .breadcrumb {
    margin-bottom: 2rem;
  }

  .breadcrumb ol {
    display: flex;
    justify-content: center;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #94a3b8;
  }

  .breadcrumb a {
    color: #38bdf8;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: #e0f2fe;
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: 0.5rem;
    color: #64748b;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    background: linear-gradient(90deg, #f1f5f9, #38bdf8, #e0f2fe);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    margin-bottom: 1.5rem;
  }

  .hero-description {
    font-size: 1.25rem;
    color: #cbd5e1;
    max-width: 48rem;
    margin: 0 auto;
    line-height: 1.6;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    color: #e0f2fe;
    font-size: 0.9rem;
  }

  .stat-item strong {
    color: #38bdf8;
    font-size: 1.1rem;
  }

  /* How to Cite Section */
  .cite-section {
    padding: 4rem 1rem;
    background: rgba(30, 41, 59, 0.3);
    backdrop-filter: blur(4px);
  }

  .cite-container {
    max-width: 80rem;
    margin: 0 auto;
  }

  .cite-toggle {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem 0;
    transition: all 0.3s ease;
  }

  .cite-toggle:hover {
    transform: translateY(-1px);
  }

  .cite-toggle:hover .cite-title {
    color: #94a3b8;
  }

  .cite-toggle:hover .toggle-icon {
    color: #94a3b8;
  }

  .cite-toggle:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 4px;
    border-radius: 0.5rem;
  }

  .cite-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: #64748b;
    margin: 0;
    text-align: right;
  }

  .toggle-icon {
    width: 1rem;
    height: 1rem;
    color: #64748b;
    transition: transform 0.3s ease;
  }

  .cite-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(180deg);
  }

  .cite-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, opacity 0.3s ease, padding 0.3s ease;
    opacity: 0;
    padding-top: 0;
  }

  .cite-content.expanded {
    max-height: 2000px;
    opacity: 1;
    padding-top: 2rem;
  }

  .cite-description {
    font-size: 1.125rem;
    color: #e0f2fe;
    text-align: center;
    max-width: 60rem;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }

  .citation-formats {
    background: rgba(30, 41, 59, 0.7);
    border-radius: 1.5rem;
    padding: 2.5rem;
    border: 1px solid rgba(56, 189, 248, 0.15);
  }

  .format-group h3 {
    color: #38bdf8;
    font-size: 1.5rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .format-item {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(51, 65, 85, 0.5);
    border-radius: 1rem;
    border: 1px solid rgba(56, 189, 248, 0.1);
  }

  .format-item h4 {
    color: #0ea5e9;
    font-size: 1.125rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .code-container {
    position: relative;
  }

  .citation-code {
    display: block;
    background: rgba(15, 23, 42, 0.8);
    color: #e0f2fe;
    padding: 1.5rem;
    padding-right: 3.5rem;
    border-radius: 0.75rem;
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .copy-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 0.5rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #38bdf8;
  }

  .copy-btn:hover {
    background: rgba(56, 189, 248, 0.2);
    border-color: #38bdf8;
    transform: scale(1.05);
  }

  .copy-btn:active {
    transform: scale(0.95);
  }

  .copy-btn svg {
    width: 1rem;
    height: 1rem;
  }

  .copy-btn.copied {
    background: rgba(34, 197, 94, 0.2);
    border-color: #22c55e;
    color: #22c55e;
  }

  .cite-note {
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 1rem;
    padding: 1.5rem;
    margin: 2rem 0;
    text-align: center;
  }

  .cite-note p {
    color: #e0f2fe;
    font-size: 1rem;
    margin: 0;
  }

  .cite-footer {
    text-align: center;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
  }

  .cite-footer p {
    color: #cbd5e1;
    margin: 0.5rem 0;
  }

  .cite-footer a {
    color: #38bdf8;
    text-decoration: none;
    font-weight: 500;
  }

  .cite-footer a:hover {
    text-decoration: underline;
  }

  .filters-section {
    padding: 2rem 1rem;
    background: rgba(30, 41, 59, 0.2);
    backdrop-filter: blur(4px);
  }

  .filters-container {
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .search-container {
    position: relative;
    width: 100%;
    max-width: 500px;
  }

  .search-input {
    width: 100%;
    padding: 1rem 3rem 1rem 1rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 0.75rem;
    color: #e0f2fe;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
  }

  .search-input::placeholder {
    color: #64748b;
  }

  .search-icon {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.25rem;
    height: 1.25rem;
    color: #64748b;
    pointer-events: none;
  }

  .filter-buttons {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .filter-label {
    color: #94a3b8;
    font-weight: 500;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: rgba(30, 41, 59, 0.7);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    color: #e0f2fe;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .filter-btn:hover {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }
  
  .filter-btn.active {
    background: rgba(56, 189, 248, 0.25);
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .citations-section {
    padding: 3rem 1rem;
  }

  .citations-container {
    max-width: 80rem;
    margin: 0 auto;
  }

  .citations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    /* Improve performance with will-change */
    will-change: transform;
  }

  .citation-item {
    /* Container for better performance */
    contain: layout style paint;
    /* Lazy loading animation */
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .citation-item.loaded {
    opacity: 1;
    transform: translateY(0);
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    .citation-item {
      transition: none;
    }
    
    .citation-card:hover {
      transform: none;
    }
    
    .filter-btn {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-description {
      font-size: 1rem;
    }
    
    .hero-stats {
      gap: 1rem;
    }
    
    .stat-item {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }
    
    .cite-title {
      font-size: 1.25rem;
    }
    
    .cite-description {
      font-size: 1rem;
    }
    
    .citation-formats {
      padding: 1.5rem;
    }
    
    .format-item {
      padding: 1rem;
    }
    
    .citation-code {
      font-size: 0.8rem;
      padding: 1rem;
      padding-right: 2.5rem;
    }
    
    .copy-btn {
      width: 1.75rem;
      height: 1.75rem;
      top: 0.5rem;
      right: 0.5rem;
    }
    
    .search-container {
      max-width: 100%;
    }
    
    .filter-buttons {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .citations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Performance optimization: Use Intersection Observer for lazy loading
  const observerOptions = {
    root: null,
    rootMargin: '50px',
    threshold: 0.1
  };

  // Lazy load citation cards
  const lazyLoadCards = () => {
    const cards = document.querySelectorAll('.citation-item');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('loaded');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    cards.forEach(card => observer.observe(card));
  };

  // Initialize cite toggle functionality
  const initializeCiteToggle = () => {
    const toggle = document.getElementById('cite-toggle') as HTMLButtonElement;
    const content = document.getElementById('cite-content') as HTMLElement;
    
    if (!toggle || !content) return;
    
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      
      // Toggle state
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      content.setAttribute('aria-hidden', isExpanded.toString());
      
      // Toggle classes
      if (isExpanded) {
        content.classList.remove('expanded');
      } else {
        content.classList.add('expanded');
      }
      
      // Announce to screen readers
      const announcement = document.createElement('div');
      announcement.setAttribute('aria-live', 'polite');
      announcement.setAttribute('aria-atomic', 'true');
      announcement.className = 'visually-hidden';
      announcement.textContent = isExpanded ? 'Citation section collapsed' : 'Citation section expanded';
      document.body.appendChild(announcement);
      
      setTimeout(() => {
        if (document.body.contains(announcement)) {
          document.body.removeChild(announcement);
        }
      }, 1000);
    });
    
    // Keyboard navigation
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle.click();
      }
    });
  };

  // Enhanced filtering with accessibility
  const initializeFilters = () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('citation-search') as HTMLInputElement;
    const citationsGrid = document.getElementById('citations-grid');
    const citationItems = citationsGrid?.querySelectorAll('.citation-item');

    if (!filterBtns.length || !citationItems) return;

    let currentFilter = 'all';
    let currentSearch = '';

    const updateResults = () => {
      let visibleCount = 0;
      
      citationItems.forEach(item => {
        const card = item.querySelector('.citation-card');
        const cardType = card?.getAttribute('data-publication-type');
        const cardText = card?.textContent?.toLowerCase() || '';
        
        const matchesFilter = currentFilter === 'all' || cardType === currentFilter;
        const matchesSearch = !currentSearch || cardText.includes(currentSearch.toLowerCase());
        const shouldShow = matchesFilter && matchesSearch;
        
        if (shouldShow) {
          (item as HTMLElement).style.display = 'block';
          item.setAttribute('aria-hidden', 'false');
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
          item.setAttribute('aria-hidden', 'true');
        }
      });

      // Announce results to screen readers
      const announcement = document.createElement('div');
      announcement.setAttribute('aria-live', 'polite');
      announcement.setAttribute('aria-atomic', 'true');
      announcement.className = 'visually-hidden';
      announcement.textContent = `Showing ${visibleCount} citations`;
      document.body.appendChild(announcement);
      
      setTimeout(() => {
        if (document.body.contains(announcement)) {
          document.body.removeChild(announcement);
        }
      }, 1000);
    };

    // Search functionality
    if (searchInput) {
      let searchTimeout: NodeJS.Timeout;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentSearch = (e.target as HTMLInputElement).value;
          updateResults();
        }, 300);
      });
    }

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;
        
        currentFilter = filter;
        
        // Update button states
        filterBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        
        // Update results
        updateResults();
      });

      // Keyboard navigation
      btn.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          (btn as HTMLElement).click();
        }
      });
    });
  };

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      lazyLoadCards();
      initializeFilters();
      initializeCiteToggle();
    });
  } else {
    lazyLoadCards();
    initializeFilters();
    initializeCiteToggle();
  }

  // Performance: Debounce scroll events
  let scrollTimeout;
  window.addEventListener('scroll', () => {
    if (scrollTimeout) clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      // Handle any scroll-based optimizations here
    }, 100);
  }, { passive: true });

  // Performance monitoring
  if (typeof performance !== 'undefined') {
    performance.mark('citations-page-loaded');
    performance.measure('citations-page-load', 'navigationStart', 'citations-page-loaded');
  }

  // Copy citation function
  function copyCitation(elementId: string) {
    const element = document.getElementById(elementId) as HTMLElement;
    if (!element) {
      console.error('Element not found:', elementId);
      return;
    }
    
    const text = element.textContent || element.innerText;
    
    navigator.clipboard.writeText(text).then(() => {
      const button = element.parentElement?.querySelector('.copy-btn') as HTMLButtonElement;
      if (!button) {
        console.error('Copy button not found');
        return;
      }
      
      const originalText = button.innerHTML;
      
      // Visual feedback
      button.classList.add('copied');
      button.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20,6 9,17 4,12"></polyline>
        </svg>
      `;
      
      // Reset after 2 seconds
      setTimeout(() => {
        button.classList.remove('copied');
        button.innerHTML = originalText;
      }, 2000);
      
      // Announce to screen readers
      const announcement = document.createElement('div');
      announcement.setAttribute('aria-live', 'polite');
      announcement.setAttribute('aria-atomic', 'true');
      announcement.className = 'visually-hidden';
      announcement.textContent = 'Citation copied to clipboard';
      document.body.appendChild(announcement);
      
      setTimeout(() => {
        if (document.body.contains(announcement)) {
          document.body.removeChild(announcement);
        }
      }, 1000);
    }).catch(err => {
      console.error('Failed to copy citation:', err);
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = text;
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
    });
  }
</script> 