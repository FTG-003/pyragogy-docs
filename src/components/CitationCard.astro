---
// Astro frontmatter block: all JS/TS and imports go here!
// Removed import { Badge } from '@astrojs/starlight/components';

interface Props {
  title: string;
  quote: string;
  authors: string[];
  source: string;
  doi?: string;
  url?: string;
  tags: string[];
  year?: number;
  publicationType?: string;
  verified?: boolean;
}

const { 
  title, 
  quote, 
  authors, 
  source, 
  doi, 
  url, 
  tags, 
  year, 
  publicationType, 
  verified = false 
} = Astro.props;

const authorsText = Array.isArray(authors) ? authors.join(', ') : authors;
const tagsArray = Array.isArray(tags) ? tags : [];

const getPublicationIcon = (type?: string) => {
  switch (type) {
    case 'journal': return '📚';
    case 'conference': return '🎤';
    case 'book': return '📖';
    case 'report': return '📄';
    case 'blog': return '✍️';
    case 'news': return '📰';
    default: return '📚';
  }
};

const getPublicationLabel = (type?: string) => {
  switch (type) {
    case 'journal': return 'Academic Journal';
    case 'conference': return 'Conference Paper';
    case 'book': return 'Book Chapter';
    case 'report': return 'Research Report';
    case 'blog': return 'Blog Post';
    case 'news': return 'News Article';
    default: return 'Publication';
  }
};
---

<div class="citation-card" data-citation-title={title} data-publication-type={publicationType}>
  <div class="card-header">
    <div class="title-section">
      <h3 class="citation-title">{title}</h3>
    </div>
    <div class="meta-info">
      {year && <span class="year">{year}</span>}
      {publicationType && <span class="publication-type">{publicationType}</span>}
    </div>
  </div>

  <blockquote class="citation-quote">
    "{quote}"
  </blockquote>

  <div class="authors-section">
    <span class="authors-label">Authors:</span>
    <span class="authors">{authorsText}</span>
  </div>

  <div class="source-section">
    <span class="source-label">Source:</span>
    <span class="source">{source}</span>
  </div>

  <div class="tags-section">
    {tagsArray.map(tag => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  <div class="card-footer">
    {doi && (
      <a href={`https://doi.org/${doi}`} class="doi-link" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        DOI: {doi}
      </a>
    )}
    {url && !doi && (
      <a href={url} class="url-link" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15,3 21,3 21,9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        View Source
      </a>
    )}
    <button class="expand-btn" onclick="expandCitation(this)" aria-label="Expand citation details">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6,9 12,15 18,9"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .citation-card {
    background: var(--card-bg, linear-gradient(135deg, rgba(30, 41, 59, 0.85), rgba(51, 65, 85, 0.85)));
    border: 1px solid var(--border-color, rgba(56, 189, 248, 0.12));
    border-radius: 1.5rem;
    padding: 2.5rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    /* Performance optimizations */
    will-change: transform;
    contain: layout style paint;
    /* Accessibility */
    tabindex: 0;
    /* GPU acceleration */
    transform: translateZ(0);
  }

  .citation-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #38bdf8, #0ea5e9);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .citation-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: #38bdf8;
    box-shadow: 
      0 25px 50px -12px rgba(30, 41, 59, 0.7),
      0 0 0 1px #38bdf8,
      0 0 20px rgba(56, 189, 248, 0.15);
  }

  .citation-card:hover::before {
    transform: scaleX(1);
  }

  /* Loading skeleton */
  .citation-card.loading {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Expanded section styles */
  .expanded-section {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
    animation: slideDown 0.3s ease-out;
  }

  .expanded-citation h3 {
    color: #38bdf8;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .expanded-quote {
    font-style: italic;
    color: #e0f2fe;
    margin: 1rem 0;
    padding: 1rem;
    background: rgba(56, 189, 248, 0.05);
    border-radius: 0.5rem;
    border-left: 3px solid #38bdf8;
  }

  .expanded-details {
    margin-top: 1.5rem;
  }

  .expanded-details p {
    margin: 0.5rem 0;
    color: #cbd5e1;
  }

  .expanded-details strong {
    color: #38bdf8;
  }

  .expanded-details a {
    color: #38bdf8;
    text-decoration: none;
  }

  .expanded-details a:hover {
    text-decoration: underline;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .title-section {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    flex: 1;
  }

  .citation-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary, #FFFFFF);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.02em;
    flex: 1;
  }



  .meta-info {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .year {
    background: #38bdf8;
    color: #0f172a;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .publication-type {
    background: #0ea5e9;
    color: #f1f5f9;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .citation-quote {
    font-family: 'Georgia', serif;
    font-size: 1.125rem;
    line-height: 1.7;
    color: #e0f2fe;
    margin: 2rem 0;
    padding: 0;
    border-left: 4px solid #38bdf8;
    padding-left: 1.5rem;
    font-style: italic;
    position: relative;
  }

  .citation-quote::before {
    content: '"';
    font-size: 3rem;
    color: #38bdf8;
    position: absolute;
    left: -0.5rem;
    top: -0.5rem;
    font-family: serif;
    opacity: 0.3;
  }

  .authors-section,
  .source-section {
    margin-bottom: 1.5rem;
  }

  .authors-label,
  .source-label {
    font-weight: 600;
    color: #94a3b8;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 0.5rem;
  }

  .authors,
  .source {
    color: #f1f5f9;
    font-weight: 500;
  }

  .tags-section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(14, 165, 233, 0.15));
    color: #e0f2fe;
    padding: 0.375rem 0.875rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid rgba(56, 189, 248, 0.2);
    transition: all 0.3s ease;
  }

  .tag:hover {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(14, 165, 233, 0.3));
    transform: translateY(-1px);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .doi-link,
  .url-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #38bdf8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border-radius: 0.75rem;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.15);
    transition: all 0.3s ease;
  }

  .doi-link:hover,
  .url-link:hover {
    background: #38bdf8;
    color: #0f172a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.15);
  }

  .doi-link svg,
  .url-link svg {
    width: 1rem;
    height: 1rem;
  }

  .expand-btn {
    background: transparent;
    border: 1px solid rgba(56, 189, 248, 0.15);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #94a3b8;
  }

  .expand-btn:hover {
    background: #38bdf8;
    color: #0f172a;
    border-color: #38bdf8;
    transform: scale(1.1);
  }

  .expand-btn svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }

  .expand-btn.expanded svg {
    transform: rotate(180deg);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .citation-card {
      padding: 1.5rem;
      border-radius: 1rem;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .citation-title {
      font-size: 1.25rem;
      line-height: 1.3;
    }

    .title-section {
      align-items: flex-start;
    }

    .meta-info {
      gap: 0.5rem;
    }

    .year,
    .publication-type {
      font-size: 0.8rem;
      padding: 0.25rem 0.625rem;
    }

    .citation-quote {
      font-size: 1rem;
      padding-left: 1rem;
      margin: 1.5rem 0;
      line-height: 1.6;
    }

    .citation-quote::before {
      font-size: 2.5rem;
      left: -0.25rem;
      top: -0.25rem;
    }

    .authors-section,
    .source-section {
      margin-bottom: 1.25rem;
    }

    .authors-label,
    .source-label {
      font-size: 0.8rem;
      margin-right: 0.375rem;
    }

    .authors,
    .source {
      font-size: 0.95rem;
    }

    .tags-section {
      gap: 0.375rem;
      margin-bottom: 1.5rem;
    }

    .tag {
      font-size: 0.8rem;
      padding: 0.25rem 0.75rem;
      border-radius: 0.75rem;
    }

    .card-footer {
      flex-direction: column;
      gap: 0.75rem;
      align-items: stretch;
    }

    .doi-link,
    .url-link {
      justify-content: center;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      border-radius: 0.625rem;
    }

    .expand-btn {
      align-self: center;
      width: 2.25rem;
      height: 2.25rem;
    }

    .expand-btn svg {
      width: 0.875rem;
      height: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .citation-card {
      padding: 1.25rem;
      border-radius: 0.875rem;
    }

    .citation-title {
      font-size: 1.125rem;
    }

    .citation-quote {
      font-size: 0.95rem;
      padding-left: 0.875rem;
      margin: 1.25rem 0;
    }

    .citation-quote::before {
      font-size: 2rem;
      left: -0.125rem;
      top: -0.125rem;
    }

    .authors-section,
    .source-section {
      margin-bottom: 1rem;
    }

    .authors-label,
    .source-label {
      font-size: 0.75rem;
      margin-right: 0.25rem;
    }

    .authors,
    .source {
      font-size: 0.9rem;
    }

    .tags-section {
      gap: 0.25rem;
      margin-bottom: 1.25rem;
    }

    .tag {
      font-size: 0.75rem;
      padding: 0.25rem 0.625rem;
      border-radius: 0.625rem;
    }

    .doi-link,
    .url-link {
      padding: 0.625rem 0.875rem;
      font-size: 0.8rem;
    }

    .expand-btn {
      width: 2rem;
      height: 2rem;
    }

    .expand-btn svg {
      width: 0.75rem;
      height: 0.75rem;
    }
  }

  /* Extra small devices */
  @media (max-width: 360px) {
    .citation-card {
      padding: 1rem;
    }

    .citation-title {
      font-size: 1rem;
    }

    .citation-quote {
      font-size: 0.9rem;
      padding-left: 0.75rem;
    }

    .citation-quote::before {
      font-size: 1.75rem;
    }

    .tag {
      font-size: 0.7rem;
      padding: 0.25rem 0.5rem;
    }

    .doi-link,
    .url-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
    }
  }

  /* Touch-friendly improvements */
  @media (hover: none) and (pointer: coarse) {
    .citation-card:hover {
      transform: none;
    }

    .citation-card:active {
      transform: scale(0.98);
    }

    .tag:hover {
      transform: none;
    }

    .tag:active {
      transform: scale(0.95);
    }

    .doi-link:hover,
    .url-link:hover {
      transform: none;
    }

    .doi-link:active,
    .url-link:active {
      transform: scale(0.95);
    }

    .expand-btn:hover {
      transform: none;
    }

    .expand-btn:active {
      transform: scale(0.9);
    }
  }

  /* High DPI displays */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .citation-card {
      border-width: 0.5px;
    }

    .tag {
      border-width: 0.5px;
    }

    .doi-link,
    .url-link {
      border-width: 0.5px;
    }

    .expand-btn {
      border-width: 0.5px;
    }
  }
</style>

<script>
  function expandCitation(button) {
    const card = button.closest('.citation-card');
    const title = card.dataset.citationTitle;
    
    // Toggle button state
    button.classList.toggle('expanded');
    
    // Get citation data from the card
    const quote = card.querySelector('.citation-quote')?.textContent?.trim() || '';
    const authors = card.querySelector('.authors')?.textContent || '';
    const source = card.querySelector('.source')?.textContent || '';
    const tags = Array.from(card.querySelectorAll('.tag')).map(tag => (tag as HTMLElement).textContent || '').join(', ');
    const doi = card.querySelector('.doi-link')?.textContent?.replace('DOI: ', '') || '';
    const url = card.querySelector('.url-link')?.href || '';
    
    // Create expanded content
    const expandedContent = `
      <div class="expanded-citation">
        <h3>${title}</h3>
        <blockquote class="expanded-quote">${quote}</blockquote>
        <div class="expanded-details">
          <p><strong>Authors:</strong> ${authors}</p>
          <p><strong>Source:</strong> ${source}</p>
          <p><strong>Tags:</strong> ${tags}</p>
          ${doi ? `<p><strong>DOI:</strong> <a href="https://doi.org/${doi}" target="_blank">${doi}</a></p>` : ''}
          ${url ? `<p><strong>URL:</strong> <a href="${url}" target="_blank">View Source</a></p>` : ''}
        </div>
      </div>
    `;
    
    // Toggle expanded content
    let expandedSection = card.querySelector('.expanded-section');
    if (expandedSection) {
      expandedSection.remove();
    } else {
      expandedSection = document.createElement('div');
      expandedSection.className = 'expanded-section';
      expandedSection.innerHTML = expandedContent;
      card.appendChild(expandedSection);
    }
  }

  // Add click handler to expand buttons
  document.addEventListener('DOMContentLoaded', () => {
    const expandButtons = document.querySelectorAll('.expand-btn');
    expandButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.stopPropagation();
        expandCitation(button);
      });
    });
  });
</script> 