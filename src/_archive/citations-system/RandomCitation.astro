import { getCollection } from 'astro:content';

// Get all citations and select a random one
const citations = await getCollection('citations');
const randomCitation = citations[Math.floor(Math.random() * citations.length)];

if (!randomCitation) {
  return null;
}

const { title, quote, authors, source, year, verified } = randomCitation.data;

<div class="random-citation">
  <div class="citation-header">
    <span class="citation-icon">📚</span>
    <span class="citation-label">Featured Citation</span>
    {verified && <span class="verified-badge">✓ Verified</span>}
  </div>
  
  <blockquote class="citation-quote">
    "{quote.length > 200 ? quote.substring(0, 200) + '...' : quote}"
  </blockquote>
  
  <div class="citation-meta">
    <div class="citation-authors">
      {authors.slice(0, 2).join(', ')}
      {authors.length > 2 && ` et al.`}
    </div>
    <div class="citation-source">
      {source}
      {year && ` (${year})`}
    </div>
  </div>
  
  <a href="/citations" class="view-all-link">
    View all citations →
  </a>
</div>

